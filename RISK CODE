#CALCULATE VAR AND ES FOR NON-NORMAL DISTIRBUTIONS
```{r}
#| label: tests
alpha <- 0.05  # 95% Confidence Level

# Fit t-distribution for Method 1
t.fit <- fitdistr(logret_acn, "t")
m <- t.fit$estimate[1]
s <- t.fit$estimate[2]
df <- t.fit$estimate[3]

# ---------------------------------------------------------
# Method 1: Scaled t-distribution
# ---------------------------------------------------------
set.seed(123789)
rsim1 <- rep(0, 100000)
for (i in 1:10) {
  rsim1 <- rsim1 + rt.scaled(100000, mean = m, sd = s, df = df)
}

VaR1 <- quantile(rsim1, alpha)
ES1  <- mean(rsim1[rsim1 < VaR1])

# Q1 & Q2
cat("Q1 (Method 1 VaR):", round(VaR1, 6), "\n")
cat("Q2 (Method 1 ES) :", round(ES1, 6), "\n\n")

# ---------------------------------------------------------
# Method 2: Empirical i.i.d. Bootstrap
# ---------------------------------------------------------
set.seed(123789)
rvec2 <- rep(0, 100000)
for (i in 1:10) {
  rvec2 <- rvec2 + sample(as.vector(logret_acn), 100000, replace = TRUE)
}

VaR2 <- quantile(rvec2, alpha)
ES2 <- mean(rvec2[rvec2 < VaR2])

# Q3 & Q4
cat("Q3 (Method 2 VaR):", VaR2, "\n")
cat("Q4 (Method 2 ES) :", ES2, "\n\n")

# ---------------------------------------------------------
# Method 3: 10 Consecutive Days (Block Bootstrap)
# ---------------------------------------------------------
rvec <- as.vector(logret_acn)
set.seed(123789)
rsim3 <- rep(0, 100000)
posn <- seq(from = 1, to = length(rvec) - 9, by = 1)
rpos <- sample(posn, 100000, replace = TRUE)

for (i in 1:10) {
  rsim3 <- rsim3 + rvec[rpos]
  rpos <- rpos + 1
}

VaR3 <- quantile(rsim3, alpha)
ES3  <- mean(rsim3[rsim3 < VaR3])

# Q5 & Q6
cat("Q5 (Method 3 VaR):", round(VaR3, 6), "\n")
cat("Q6 (Method 3 ES) :", round(ES3, 6), "\n")
```

