#RATIO ANALYSIS
```{r}
library(quantmod)
library(rugarch)

# 1. Fetch Accenture (ACN), Market (^GSPC), and Risk-Free Rate (^IRX) Data
acn <- getSymbols("ACN", src = "yahoo", auto.assign = FALSE)[, 4]
sp500 <- getSymbols("^GSPC", src = "yahoo", auto.assign = FALSE)[, 4]
irx_data <- getSymbols("^IRX", src = "yahoo", auto.assign = FALSE)

# 2. Clean missing values
acn <- na.omit(acn)
sp500 <- na.omit(sp500)

# 3. Calculate Log Returns
logret_acn <- diff(log(acn))[-1]
logret_mkt <- diff(log(sp500))[-1]

# 4. Extract Close price for IRX and convert to daily log rate
rf_annual <- na.omit(Cl(irx_data)) / 100
rf_daily_log <- log(1 + (rf_annual / 252))

# 5. Align all dates using inner join
data_combined <- merge(logret_acn, logret_mkt, rf_daily_log, join = "inner")
colnames(data_combined) <- c("ACN", "Market", "RF")

logret_acn <- data_combined$ACN
logret_mkt <- data_combined$Market
rf_matched <- data_combined$RF

# --- DEFINE PERFORMANCE METRIC FUNCTIONS ---

# Sortino Ratio Function
calc_sortino <- function(logret, rf, mar = 0) {
  excess_ret <- logret - rf
  mean_excess <- mean(excess_ret, na.rm = TRUE)
  
  # Downside deviation relative to MAR
  downside_diff <- pmin(0, logret - mar)
  downside_dev  <- sqrt(mean(downside_diff^2, na.rm = TRUE))
  
  # Annualize: Daily Sortino * sqrt(252)
  annual_sortino <- (mean_excess / downside_dev) * sqrt(252)
  return(as.numeric(annual_sortino))
}

# Treynor Ratio Function
calc_treynor <- function(logret_p, logret_m, rf) {
  excess_p <- logret_p - rf
  excess_m <- logret_m - rf
  
  mean_excess_p <- mean(excess_p, na.rm = TRUE)
  
  # Calculate Systematic Risk (Beta)
  beta_p <- cov(excess_p, excess_m, use = "complete.obs") / var(excess_m, na.rm = TRUE)
  
  # Annualize: Daily Treynor * 252
  annual_treynor <- (mean_excess_p / beta_p) * 252
  return(list(Treynor = as.numeric(annual_treynor), Beta = as.numeric(beta_p)))
}

# --- CALCULATE RATIOS FOR ACN ---

sortino_acn <- calc_sortino(logret_acn, rf = rf_matched, mar = 0)
treynor_acn <- calc_treynor(logret_acn, logret_mkt, rf = rf_matched)

cat("--- Performance Metrics for ACN ---\n")
cat("Annualized Sortino Ratio :", round(sortino_acn, 4), "\n")
cat("Beta                     :", round(treynor_acn$Beta, 4), "\n")
cat("Annualized Treynor Ratio :", round(treynor_acn$Treynor, 4), "\n")
